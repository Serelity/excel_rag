# Stage A: Qwen3 semantic extraction on one H100. This file is sourced by Bash.
CONDA_EXTRACT_ENV=civic-rag-extract
CONDA_INDEX_ENV=civic-rag-index
CONDA_RETRIEVAL_ENV=civic-rag-retrieval

# Leave empty when package mirrors are reachable. For offline pip installation,
# set this to an absolute wheelhouse containing every transitive dependency.
# Conda must separately resolve its base packages from a mirror, local channel,
# or populated package cache.
RAG_WHEELHOUSE=
PYTORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu124

# Persistent records, request-free job logs, model, cache, and input. These
# defaults assume this file remains at deploy/.env. Replace individual values
# with absolute paths when assets live outside the Git checkout.
RAG_PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
QWEN_MODEL_PATH=$RAG_PROJECT_ROOT/models/Qwen3-30B-A3B
BGE_M3_MODEL_PATH=$RAG_PROJECT_ROOT/models/bge-m3
# Record the immutable ModelScope source revision when the snapshot is downloaded.
BGE_M3_MODEL_REVISION=unknown
RAG_INPUT_PATH=$RAG_PROJECT_ROOT/data/raw/t_order_master.sanitized.v1_9.tsv
RAG_RUN_RECORDS_PATH=$RAG_PROJECT_ROOT/run-records
RAG_RETRIEVAL_DATA_PATH=$RAG_PROJECT_ROOT/data/retrieval/title-v1
RAG_RETRIEVAL_RUN_PATH=$RAG_RUN_RECORDS_PATH/retrieval-baselines
RAG_JOB_LOG_DIR=$RAG_RUN_RECORDS_PATH/extraction-jobs
RAG_JOB_LOCK_PATH=$RAG_RUN_RECORDS_PATH/extraction-job.lock
VLLM_CACHE_PATH=$RAG_PROJECT_ROOT/.cache/vllm

# The platform should expose exactly one complete H100 80 GB to this task.
GPU_ID=0

# Audited local ModelScope snapshot. No Hugging Face access is used.
QWEN_SERVED_MODEL_NAME=Qwen3-30B-A3B
QWEN_MODELSCOPE_REPO_ID=Qwen/Qwen3-30B-A3B
# Record the ModelScope source revision when known; "unknown" is accepted and
# the local content fingerprint remains the binding identity.
QWEN_MODEL_REVISION=unknown
# Run deploy/model-fingerprint.py in the first H100 session, then replace this
# value before running the read-only preflight.
QWEN_MODEL_FINGERPRINT_SHA256=sha256:REPLACE_WITH_64_HEX

VLLM_HOST=127.0.0.1
VLLM_PORT=8000
# Optional. Leave empty for an unauthenticated loopback-only service. When set,
# use a 32-128 character URL-safe token, for example secrets.token_urlsafe(32).
VLLM_API_KEY=

# Conservative Qwen3-30B-A3B BF16 pilot values for one full H100 80 GB.
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=8
VLLM_MAX_NUM_BATCHED_TOKENS=8192
# Set to 1 only if the documented OOM troubleshooting sequence requires it.
VLLM_ENFORCE_EAGER=0
VLLM_STARTUP_TIMEOUT_SECONDS=1800
VLLM_HEALTH_POLL_SECONDS=5
# Abort extraction after this many consecutive failed runtime health probes.
VLLM_HEALTH_FAILURE_LIMIT=6
VLLM_SHUTDOWN_TIMEOUT_SECONDS=60

# All Stage A jobs that can see the same H100 must use the same lock path above.

# Only the sanitized TSV is permitted. The job verifies both values before it
# starts vLLM and never decodes or prints a row during this check.
RAG_INPUT_SIZE_BYTES=655769345
RAG_INPUT_SHA256=1b778548b618de5f051e749232e47648323979898397588ac79b53d2123aac0c
