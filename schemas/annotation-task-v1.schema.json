{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/12345/schemas/annotation-task-v1.schema.json",
  "title": "12345 SAG annotation task V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "schema_version",
    "split",
    "stratum",
    "source_document_id",
    "source",
    "annotations",
    "status",
    "annotator_id"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^task_[A-Za-z0-9_-]+$"},
    "schema_version": {"const": "1.0.0"},
    "split": {"type": "string", "enum": ["train", "dev", "test"]},
    "stratum": {"type": "string", "minLength": 1},
    "source_document_id": {"type": "string", "pattern": "^co_[A-Za-z0-9_-]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representative_standard_order_id",
        "service_object_type",
        "case_content",
        "case_goal",
        "title",
        "return_visit_reason",
        "remark",
        "appeal_result_opinions",
        "department_name",
        "form_type",
        "classification_l1",
        "classification_l2",
        "classification_l3",
        "classification_l4",
        "classification_l5",
        "city",
        "area",
        "street",
        "order_source",
        "call_time",
        "case_complete_time",
        "order_finish_time",
        "quality_flags"
      ],
      "properties": {
        "representative_standard_order_id": {"type": ["string", "null"]},
        "service_object_type": {"type": ["string", "null"]},
        "case_content": {"type": ["string", "null"]},
        "case_goal": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "return_visit_reason": {"type": ["string", "null"]},
        "remark": {"type": ["string", "null"]},
        "appeal_result_opinions": {"type": ["string", "null"]},
        "department_name": {"type": ["string", "null"]},
        "form_type": {"type": ["string", "null"]},
        "classification_l1": {"type": ["string", "null"]},
        "classification_l2": {"type": ["string", "null"]},
        "classification_l3": {"type": ["string", "null"]},
        "classification_l4": {"type": ["string", "null"]},
        "classification_l5": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "area": {"type": ["string", "null"]},
        "street": {"type": ["string", "null"]},
        "order_source": {"type": ["string", "null"]},
        "call_time": {"type": ["string", "null"]},
        "case_complete_time": {"type": ["string", "null"]},
        "order_finish_time": {"type": ["string", "null"]},
        "quality_flags": {"type": ["string", "null"]}
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "entities",
        "entity_mentions",
        "event_entity_relations",
        "event_event_relations",
        "warnings"
      ],
      "properties": {
        "events": {"type": "array"},
        "entities": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity_resolution_annotation"}
        },
        "entity_mentions": {"type": "array"},
        "event_entity_relations": {"type": "array"},
        "event_event_relations": {"type": "array"},
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "AMBIGUOUS_EVENT_BOUNDARY",
              "AMBIGUOUS_ENTITY",
              "AMBIGUOUS_TIME",
              "INSUFFICIENT_EVIDENCE",
              "PII_PLACEHOLDER_PRESENT"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["unannotated", "in_progress", "submitted", "reviewed", "adjudicated"]
    },
    "annotator_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "entity_resolution_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_entity_id",
        "canonical_name",
        "normalized_name",
        "entity_type",
        "entity_subtype",
        "mention_ids",
        "resolution_status",
        "existing_entity_id",
        "context",
        "confidence"
      ],
      "properties": {
        "local_entity_id": {"type": "string", "pattern": "^ce[1-9][0-9]*$"},
        "canonical_name": {"type": "string", "minLength": 1, "maxLength": 300},
        "normalized_name": {"type": "string", "minLength": 1, "maxLength": 300},
        "entity_type": {
          "type": "string",
          "enum": [
            "LOCATION",
            "ORGANIZATION",
            "GOVERNMENT_DEPARTMENT",
            "FACILITY",
            "ISSUE_TYPE",
            "ACTION_BEHAVIOR",
            "PRODUCT_SERVICE",
            "ANONYMIZED_PERSON_ROLE",
            "TEMPORAL_EXPRESSION"
          ]
        },
        "entity_subtype": {"type": ["string", "null"]},
        "mention_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^m[1-9][0-9]*$"},
          "uniqueItems": true
        },
        "resolution_status": {
          "type": "string",
          "enum": ["new_entity", "existing_entity", "ambiguous"]
        },
        "existing_entity_id": {
          "type": ["string", "null"],
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "context": {"type": "object"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
