{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/12345/schemas/extraction-result-v1.schema.json",
  "title": "12345 SAG LLM extraction result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_document_id",
    "events",
    "entity_mentions",
    "event_entity_relations",
    "event_event_relations",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_document_id": {"type": "string", "pattern": "^co_[A-Za-z0-9_-]+$"},
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    },
    "entity_mentions": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity_mention"}
    },
    "event_entity_relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/event_entity_relation"}
    },
    "event_event_relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/event_event_relation"}
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "AMBIGUOUS_EVENT_BOUNDARY",
          "AMBIGUOUS_ENTITY",
          "AMBIGUOUS_TIME",
          "INSUFFICIENT_EVIDENCE",
          "PII_PLACEHOLDER_PRESENT"
        ]
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nullable_string": {"type": ["string", "null"]},
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "start", "end", "text"],
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "case_content",
            "case_goal",
            "title",
            "return_visit_reason",
            "remark",
            "appeal_result_opinions"
          ]
        },
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_event_id",
        "event_kind",
        "summary",
        "event_type_name",
        "polarity",
        "occurred_start",
        "occurred_end",
        "temporal_precision",
        "temporal_text",
        "time_source",
        "requested_action",
        "source_spans",
        "confidence"
      ],
      "properties": {
        "local_event_id": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "event_kind": {
          "type": "string",
          "enum": [
            "ISSUE",
            "SERVICE_REQUEST",
            "CONSULTATION",
            "SUGGESTION",
            "REPORT",
            "HANDLING_ACTION",
            "OUTCOME",
            "FOLLOW_UP"
          ]
        },
        "summary": {"type": "string", "minLength": 2, "maxLength": 500},
        "event_type_name": {"$ref": "#/$defs/nullable_string"},
        "polarity": {
          "type": "string",
          "enum": ["affirmed", "negated", "uncertain", "alleged"]
        },
        "occurred_start": {"type": ["string", "null"], "format": "date-time"},
        "occurred_end": {"type": ["string", "null"], "format": "date-time"},
        "temporal_precision": {
          "type": "string",
          "enum": ["exact", "day", "month", "relative", "recurring", "unknown"]
        },
        "temporal_text": {"$ref": "#/$defs/nullable_string"},
        "time_source": {
          "type": "string",
          "enum": ["source_text", "call_time_fallback", "unknown"]
        },
        "requested_action": {"$ref": "#/$defs/nullable_string"},
        "source_spans": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_span"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "entity_mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_mention_id",
        "surface_form",
        "normalized_mention",
        "entity_type",
        "entity_subtype",
        "sensitivity",
        "source_span",
        "confidence"
      ],
      "properties": {
        "local_mention_id": {"type": "string", "pattern": "^m[1-9][0-9]*$"},
        "surface_form": {"type": "string", "minLength": 1, "maxLength": 300},
        "normalized_mention": {"type": "string", "minLength": 1, "maxLength": 300},
        "entity_type": {
          "type": "string",
          "enum": [
            "LOCATION",
            "ORGANIZATION",
            "GOVERNMENT_DEPARTMENT",
            "FACILITY",
            "ISSUE_TYPE",
            "ACTION_BEHAVIOR",
            "PRODUCT_SERVICE",
            "ANONYMIZED_PERSON_ROLE",
            "TEMPORAL_EXPRESSION"
          ]
        },
        "entity_subtype": {"$ref": "#/$defs/nullable_string"},
        "sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "sensitive", "restricted"]
        },
        "source_span": {"$ref": "#/$defs/source_span"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "event_entity_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_relation_id",
        "local_event_id",
        "local_mention_id",
        "role",
        "source_spans",
        "confidence"
      ],
      "properties": {
        "local_relation_id": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
        "local_event_id": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "local_mention_id": {"type": "string", "pattern": "^m[1-9][0-9]*$"},
        "role": {
          "type": "string",
          "enum": [
            "OCCURS_AT",
            "HAS_ISSUE",
            "HAS_BEHAVIOR",
            "INVOLVES_ORGANIZATION",
            "RESPONSIBLE_PARTY",
            "SERVICE_PROVIDER",
            "HANDLED_BY",
            "REQUESTED_HANDLER",
            "AFFECTS_FACILITY",
            "CONCERNS_PRODUCT_SERVICE",
            "INVOLVES_PERSON_ROLE",
            "HAS_TEMPORAL_EXPRESSION"
          ]
        },
        "source_spans": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_span"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "event_event_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_relation_id",
        "source_local_event_id",
        "target_local_event_id",
        "relation_type",
        "source_spans",
        "confidence"
      ],
      "properties": {
        "local_relation_id": {"type": "string", "pattern": "^er[1-9][0-9]*$"},
        "source_local_event_id": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "target_local_event_id": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "relation_type": {
          "type": "string",
          "enum": [
            "SAME_AS",
            "REPEAT_OF",
            "FOLLOW_UP_OF",
            "RESPONDS_TO",
            "CAUSES",
            "PRECEDES",
            "CONTRADICTS"
          ]
        },
        "source_spans": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_span"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
