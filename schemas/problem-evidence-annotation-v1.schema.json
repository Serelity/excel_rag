{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/12345/schemas/problem-evidence-annotation-v1.schema.json",
  "title": "12345 Problem Evidence Annotation Task V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "schema_version",
    "split",
    "source_document_id",
    "source",
    "annotations",
    "status",
    "annotator_id"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "split": {"enum": ["tuning", "locked_test"]},
    "source_document_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "annotations": {"$ref": "#/$defs/annotations"},
    "status": {"enum": ["unannotated", "in_progress", "submitted", "reviewed", "adjudicated"]},
    "annotator_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_content",
        "case_goal",
        "title",
        "classification_l1",
        "classification_l2",
        "classification_l3",
        "city",
        "area",
        "street"
      ],
      "properties": {
        "case_content": {"type": ["string", "null"]},
        "case_goal": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "classification_l1": {"type": ["string", "null"]},
        "classification_l2": {"type": ["string", "null"]},
        "classification_l3": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "area": {"type": ["string", "null"]},
        "street": {"type": ["string", "null"]}
      }
    },
    "span": {
      "type": "object",
      "required": ["local_id", "source_field", "char_start", "char_end", "evidence_text", "decision", "notes"],
      "properties": {
        "local_id": {"type": "string", "minLength": 1},
        "source_field": {"enum": ["case_content", "case_goal", "title"]},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 1},
        "evidence_text": {"type": "string", "minLength": 1},
        "decision": {"enum": ["accepted", "ambiguous", "rejected"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "issue_span": {
      "allOf": [{"$ref": "#/$defs/span"}],
      "unevaluatedProperties": false
    },
    "issue_type": {
      "allOf": [
        {"$ref": "#/$defs/span"},
        {
          "type": "object",
          "required": ["issue_local_id", "type_id"],
          "properties": {
            "issue_local_id": {"type": "string", "minLength": 1},
            "type_id": {"type": "string", "minLength": 1}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "requester_role": {
      "allOf": [
        {"$ref": "#/$defs/span"},
        {
          "type": "object",
          "required": ["role_id"],
          "properties": {"role_id": {"type": "string", "minLength": 1}}
        }
      ],
      "unevaluatedProperties": false
    },
    "location": {
      "allOf": [
        {"$ref": "#/$defs/span"},
        {
          "type": "object",
          "required": ["normalized_value", "normalization_status"],
          "properties": {
            "normalized_value": {"type": ["string", "null"]},
            "normalization_status": {"enum": ["unique", "ambiguous", "unresolved"]}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_id", "relation_type", "source_local_id", "target_local_id", "supporting_local_ids", "decision", "notes"],
      "properties": {
        "local_id": {"type": "string", "minLength": 1},
        "relation_type": {"enum": ["CLASSIFIES", "REPORTER_OF", "AFFECTED_PARTY_OF", "CONSULTANT_ABOUT", "REPORTS_VIOLATION_OF", "OCCURS_AT", "NORMALIZES", "LOCATED_WITHIN"]},
        "source_local_id": {"type": "string", "minLength": 1},
        "target_local_id": {"type": "string", "minLength": 1},
        "supporting_local_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "decision": {"enum": ["accepted", "ambiguous", "rejected"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "problem_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_id", "issue_local_ids", "type_local_ids", "requester_local_ids", "location_local_ids", "relation_local_ids", "decision", "notes"],
      "properties": {
        "local_id": {"type": "string", "minLength": 1},
        "issue_local_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "type_local_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "requester_local_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "location_local_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "relation_local_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "decision": {"enum": ["accepted", "ambiguous", "rejected"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_evidence", "text_issue_types", "requester_roles", "locations", "relations", "problem_frames", "warnings"],
      "properties": {
        "issue_evidence": {"type": "array", "items": {"$ref": "#/$defs/issue_span"}},
        "text_issue_types": {"type": "array", "items": {"$ref": "#/$defs/issue_type"}},
        "requester_roles": {"type": "array", "items": {"$ref": "#/$defs/requester_role"}},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "problem_frames": {"type": "array", "items": {"$ref": "#/$defs/problem_frame"}},
        "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
